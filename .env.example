# Postgres connection string
DATABASE_URL="postgresql://USER@localhost:5432/northgate?schema=public"

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET="replace-with-a-long-random-string"

# Anthropic API key for the /api/assistant endpoint (https://console.anthropic.com)
ANTHROPIC_API_KEY="sk-ant-..."

# Origin allowed by CORS. The Next dev server runs on 3000.
FRONTEND_ORIGIN="http://localhost:3000"
